---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Pagination from '../components/Pagination.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }) {
  const posts = (await getCollection('posts', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
---
<BaseLayout title="Блог" description="Последние записи">
  <h1 class="heading">Последние записи</h1>
  <section class="post-list">
    {page.data.map((post) => <PostCard post={post} />)}
  </section>
  <Pagination page={page} />
</BaseLayout>
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Test Repo — Astro</title>
    <style>
      body { font-family: system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, Noto Sans, "Helvetica Neue", Arial, "Apple Color Emoji", "Segoe UI Emoji"; margin: 0; padding: 2rem; background: #0b1021; color: #e6ecf1; }
      main { max-width: 60ch; margin: 10vh auto; }
      a { color: #65b7ff; }
      code { background: #121a33; padding: 0.125rem 0.25rem; border-radius: 0.25rem; }
    </style>
  </head>
  <body>
    <main>
      <h1>Welcome to the Test Repo site</h1>
      <p>This is a minimal Astro page configured for GitHub Pages project site deployment.</p>
      <ul>
        <li>Base URL detected: <code>{base}</code></li>
        <li><a href={`${base}non-existent`}>Test 404 page</a></li>
      </ul>
    </main>
  </body>
</html>
