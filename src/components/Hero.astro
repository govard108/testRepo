---
---

<section class="hero">
  <div class="hero-content">
    <div class="hero-badge">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
        <path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>
      </svg>
      <span>AI × Разработка</span>
    </div>
    
    <h1 class="hero-title">
      Исследуйте будущее<br/>
      <span class="gradient-text">веб-разработки с AI</span>
    </h1>
    
    <p class="hero-description">
      Узнайте о передовых технологиях Astro, интеграции искусственного интеллекта 
      и современных подходах к созданию высокопроизводительных веб-приложений
    </p>
    
    <div class="hero-actions">
      <a href="#posts" class="btn btn-primary">
        Исследовать статьи
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
      <a href="/tags/" class="btn btn-secondary">
        Просмотреть теги
      </a>
    </div>
    
    <div class="hero-stats">
      <div class="stat">
        <div class="stat-value">12+</div>
        <div class="stat-label">Статей</div>
      </div>
      <div class="stat">
        <div class="stat-value">8</div>
        <div class="stat-label">Категорий</div>
      </div>
      <div class="stat">
        <div class="stat-value">50+</div>
        <div class="stat-label">Тем</div>
      </div>
    </div>
  </div>
  
  <div class="hero-visual">
    <div class="floating-card card-1">
      <div class="card-icon">🚀</div>
      <div class="card-text">Astro Islands</div>
    </div>
    <div class="floating-card card-2">
      <div class="card-icon">🤖</div>
      <div class="card-text">AI Integration</div>
    </div>
    <div class="floating-card card-3">
      <div class="card-icon">⚡</div>
      <div class="card-text">Performance</div>
    </div>
  </div>
</section>
