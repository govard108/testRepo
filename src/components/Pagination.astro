---
export interface Props { page: any }
const { page } = Astro.props as Props;
const base = import.meta.env.BASE_URL;

const currentPath: string = Astro.url.pathname;
let basePath = currentPath.includes('/page/')
  ? currentPath.replace(/page\/\d+\/?$/, '')
  : (currentPath.endsWith('/') ? currentPath : currentPath + '/');

function linkFor(n: number) {
  const path = n === 1 ? basePath : `${basePath}page/${n}/`;
  return path.startsWith(base) ? path : `${base}${path.replace(/^\//, '')}`;
}
---
{page.lastPage > 1 && (
  <nav class="pagination" aria-label="Навигация по страницам">
    {page.currentPage > 1 ? (
      <a href={linkFor(page.currentPage - 1)}>← Предыдущая</a>
    ) : (
      <span class="muted">← Предыдущая</span>
    )}

    {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => (
      n === page.currentPage ? (
        <span class="current" aria-current="page">{n}</span>
      ) : (
        <a href={linkFor(n)}>{n}</a>
      )
    ))}

    {page.currentPage < page.lastPage ? (
      <a href={linkFor(page.currentPage + 1)}>Следующая →</a>
    ) : (
      <span class="muted">Следующая →</span>
    )}
  </nav>
)}
