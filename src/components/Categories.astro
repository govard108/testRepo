---
import { getCollection } from 'astro:content';
import { Bot, Building2, Settings, Zap, Rocket, BarChart3, CheckCircle, Wrench, Code, Search, FileText, ArrowRight } from 'lucide-astro';
import { slugify } from '../utils/slugify';

const posts = await getCollection('posts', ({ data }) => !data.draft);

const categoryMap = new Map<string, { count: number; iconComponent: any }>();

const categoryIcons: Record<string, any> = {
  'ai': Bot,
  'архитектура': Building2,
  'backend': Settings,
  'производительность': Zap,
  'devops': Rocket,
  'обзоры': BarChart3,
  'тестирование': CheckCircle,
  'инструменты': Wrench,
  'разработка': Code,
  'seo': Search,
  'общее': FileText
};

posts.forEach(post => {
  const category = post.data.category || 'общее';
  if (!categoryMap.has(category)) {
    categoryMap.set(category, { 
      count: 0, 
      iconComponent: categoryIcons[category] || FileText
    });
  }
  const cat = categoryMap.get(category)!;
  cat.count++;
});

const categories = Array.from(categoryMap.entries())
  .map(([name, data]) => ({ name, ...data }))
  .sort((a, b) => b.count - a.count);

const base = import.meta.env.BASE_URL;
---

<section class="categories-section">
  <div class="section-header">
    <h2 class="section-title">Категории</h2>
    <p class="section-description">Исследуйте темы по интересам</p>
  </div>
  
  <div class="categories-grid">
    {categories.map(category => {
      const Icon = category.iconComponent;
      return (
        <a href={`${base}category/${slugify(category.name)}/`} class="category-card">
          <div class="category-icon-wrapper">
            <Icon size={28} />
          </div>
          <div class="category-content">
            <h3 class="category-name">{category.name}</h3>
            <div class="category-count">
              {category.count} {category.count === 1 ? 'статья' : category.count < 5 ? 'статьи' : 'статей'}
            </div>
          </div>
          <div class="category-arrow">
            <ArrowRight size={20} />
          </div>
        </a>
      );
    })}
  </div>
</section>
